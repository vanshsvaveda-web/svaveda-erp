{
  "framework": null,
  "buildCommand": "SVAVEDA_VERCEL_BUILD=1 npm run build",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/erp?route=/"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/erp?route=/api/:path*"
    }
  ],
  "functions": {
    "api/erp.js": {
      "includeFiles": "dist/server/**"
    }
  },
  "outputDirectory": "dist/public",
  "crons": [
    {
      "path": "/api/sheets/cron",
      "schedule": "15 2 * * *"
    }
  ],
  "regions": [
    "bom1"
  ],
  "headers": [
    {
      "source": "/:file([a-z-]+\\.[a-f0-9]{12}\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
